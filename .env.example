# Security
ADMIN_TOKEN=replace-with-a-strong-private-admin-token
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# Application
APP_BIND=127.0.0.1
APP_PROFILE=skin_care
DATA_DIR=./data
SEED_DEMO=1

# ---------------------------------------------------------------------------
# Text model
# Provider choices: ollama, openai_compatible, custom, disabled
# Replace the model placeholders. No model is required by the application.
# ---------------------------------------------------------------------------
TEXT_PROVIDER=ollama
TEXT_MODEL=replace-with-your-text-model
TEXT_BASE_URL=http://host.docker.internal:11434
TEXT_API_KEY=
TEXT_PROVIDER_FACTORY=
TEXT_TEMPERATURE=0.6
TEXT_MAX_TOKENS=
TEXT_TIMEOUT_SECONDS=180
TEXT_HEADERS_JSON={}
TEXT_EXTRA_BODY_JSON={}
TEXT_TOOL_CALLING=true
# local, external, or unknown
TEXT_PRIVACY_MODE=unknown

# ---------------------------------------------------------------------------
# Vision model
# Required by the facial skincare workflow unless explicitly disabled.
# ---------------------------------------------------------------------------
VISION_PROVIDER=ollama
VISION_MODEL=replace-with-your-vision-model
VISION_BASE_URL=http://host.docker.internal:11434
VISION_API_KEY=
VISION_ENDPOINT=
VISION_PROVIDER_FACTORY=
VISION_TEMPERATURE=0.3
VISION_MAX_TOKENS=
VISION_STREAM=true
VISION_TIMEOUT_SECONDS=300
VISION_HEADERS_JSON={}
VISION_EXTRA_BODY_JSON={}
# local, external, or unknown
VISION_PRIVACY_MODE=unknown

# OpenAI-compatible example:
# TEXT_PROVIDER=openai_compatible
# TEXT_BASE_URL=https://your-provider.example/v1
# TEXT_MODEL=your-provider-model-id
# TEXT_API_KEY=your-api-key
# VISION_PROVIDER=openai_compatible
# VISION_BASE_URL=https://your-provider.example/v1
# VISION_MODEL=your-provider-vision-model-id
# VISION_API_KEY=your-api-key

# Custom provider factory example:
# TEXT_PROVIDER=custom
# TEXT_PROVIDER_FACTORY=my_package.providers:create_chat_model
# VISION_PROVIDER=custom
# VISION_PROVIDER_FACTORY=my_package.providers:create_vision_adapter

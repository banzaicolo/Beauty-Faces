# Copy this file to .env and replace both values.
# Generate values with: openssl rand -base64 32
ADMIN_TOKEN=replace-with-a-strong-private-admin-token
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local development defaults. Use true only behind HTTPS.
COOKIE_SECURE=false
APP_BIND=127.0.0.1
SEED_DEMO=1

# Ollama is the default provider. Confirm that the configured URL is trusted.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.5:4b
VLM_MODEL=qwen3-vl:8b

# Optional external text model. Enabling this sends text prompts off-device.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
